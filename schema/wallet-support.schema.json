{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jaylann/apple-wallet-support-tracker/schema/wallet-support.schema.json",
  "title": "Apple Wallet Support — Brand Record",
  "description": "Per-brand record of native Apple Wallet support, iOS Live Activity, Watch sync, and known issues. Lives at data/brands/<slug>/data.json.",
  "type": "object",
  "required": [
    "$schemaVersion",
    "slug",
    "brand",
    "category",
    "region",
    "nativePkpass",
    "iosLiveActivity",
    "watchSync",
    "lastChecked",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "$schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 2,
      "maxLength": 60,
      "description": "Stable folder name. Must match the parent directory name and the entry in index.json."
    },
    "brand": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "category": {
      "type": "string",
      "enum": [
        "airline",
        "transit",
        "loyalty",
        "event",
        "sports",
        "hotel",
        "cinema",
        "credentials"
      ]
    },
    "region": {
      "type": "string",
      "enum": [
        "global",
        "north-america",
        "europe",
        "dach",
        "uk-ireland",
        "asia-pacific",
        "gulf"
      ]
    },
    "nativePkpass": {
      "type": "string",
      "enum": ["full", "partial", "none"]
    },
    "iosLiveActivity": { "type": "boolean" },
    "watchSync": { "type": "boolean" },
    "knownIssues": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 200 },
      "maxItems": 10
    },
    "lastChecked": { "type": "string", "format": "date" },
    "articleSlug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Optional cross-link to a NeatPass Learn article."
    },
    "notes": { "type": "string", "minLength": 1, "maxLength": 500 },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/definitions/source" }
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "required": ["url", "accessedAt", "type"],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "accessedAt": { "type": "string", "format": "date" },
        "type": {
          "type": "string",
          "enum": ["official", "press", "support", "community"]
        },
        "note": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
