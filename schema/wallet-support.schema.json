{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jaylann/apple-wallet-support-tracker/schema/wallet-support.schema.json",
  "title": "Apple Wallet Support Tracker",
  "description": "Per-brand record of native Apple Wallet support, iOS Live Activity, Watch sync, and known issues.",
  "type": "object",
  "required": ["$schemaVersion", "lastModified", "rows"],
  "additionalProperties": false,
  "properties": {
    "$schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver of the dataset shape. Bump on breaking changes; document in CHANGELOG."
    },
    "lastModified": {
      "type": "string",
      "format": "date",
      "description": "ISO date (YYYY-MM-DD) of the most recent modification across all rows."
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/row" }
    }
  },
  "definitions": {
    "row": {
      "type": "object",
      "required": [
        "brand",
        "category",
        "region",
        "nativePkpass",
        "iosLiveActivity",
        "watchSync",
        "lastChecked",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "brand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "enum": [
            "airline",
            "transit",
            "loyalty",
            "event",
            "sports",
            "hotel",
            "cinema",
            "credentials"
          ]
        },
        "region": {
          "type": "string",
          "enum": [
            "global",
            "north-america",
            "europe",
            "dach",
            "uk-ireland",
            "asia-pacific",
            "gulf"
          ]
        },
        "nativePkpass": {
          "type": "string",
          "enum": ["full", "partial", "none"],
          "description": "full = ships native pkpass reliably; partial = inconsistent or in-app fallback; none = no native path."
        },
        "iosLiveActivity": {
          "type": "boolean",
          "description": "Whether the brand's iOS app exposes a Live Activity (lock screen / Dynamic Island)."
        },
        "watchSync": {
          "type": "boolean",
          "description": "Whether passes reliably sync to Apple Watch."
        },
        "knownIssues": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 },
          "maxItems": 10
        },
        "lastChecked": {
          "type": "string",
          "format": "date"
        },
        "articleSlug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Optional slug of a NeatPass Learn article covering this brand."
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/definitions/source" },
          "description": "Citations supporting the row's facts. Empty allowed at v1.0.0 bootstrap; sweep agents must populate on touch."
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["url", "accessedAt", "type"],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "accessedAt": {
          "type": "string",
          "format": "date"
        },
        "type": {
          "type": "string",
          "enum": ["official", "press", "support", "community"],
          "description": "official = brand's own page; press = major outlet; support = Apple/brand support docs; community = forum/social (supporting evidence only)."
        },
        "note": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
